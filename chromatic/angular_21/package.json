{
  "name": "accretion-ui-angular-21-chromatic",
  "private": true,
  "version": "0.1.0",
  "description": "Storybook and Chromatic for @accretion_ui/angular_21",
  "scripts": {
    "storybook": "ng run chromatic-angular-21:storybook",
    "build-storybook": "ng run chromatic-angular-21:build-storybook",
    "chromatic": "test -n \"$CHROMATIC_PROJECT_TOKEN_ANGULAR_21\" && chromatic --project-token=\"$CHROMATIC_PROJECT_TOKEN_ANGULAR_21\" --build-script-name=build-storybook --exit-zero-on-changes || (echo 'Missing CHROMATIC_PROJECT_TOKEN_ANGULAR_21' && exit 1)"
  },
  "dependencies": {
    "@accretion_ui/angular_21": "file:../../components/angular_21/dist",
    "@accretion_ui/core": "file:../../components/core",
    "@angular/animations": "21.2.0",
    "@angular/common": "21.2.0",
    "@angular/compiler": "21.2.0",
    "@angular/core": "21.2.0",
    "@angular/platform-browser": "21.2.0",
    "@angular/platform-browser-dynamic": "21.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "21.2.0",
    "@angular/cli": "21.2.0",
    "@storybook/addon-a11y": "^10.2.15",
    "@storybook/angular": "^10.2.14",
    "chromatic": "^15.2.0",
    "storybook": "^10.2.14",
    "typescript": "~5.9.2"
  }
}
