{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": false,
    "types": ["node"]
  },
  "include": [".storybook/**/*.ts", "src/**/*.ts", "src/**/*.d.ts"]
}
