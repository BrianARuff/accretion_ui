{
  "name": "accretion-ui-angular-18-chromatic",
  "private": true,
  "version": "0.1.0",
  "description": "Storybook and Chromatic for @accretion_ui/angular_18",
  "scripts": {
    "storybook": "ng run chromatic-angular-18:storybook",
    "build-storybook": "ng run chromatic-angular-18:build-storybook",
    "chromatic": "test -n \"$CHROMATIC_PROJECT_TOKEN_ANGULAR_18\" && chromatic --project-token=\"$CHROMATIC_PROJECT_TOKEN_ANGULAR_18\" --build-script-name=build-storybook --exit-zero-on-changes || (echo 'Missing CHROMATIC_PROJECT_TOKEN_ANGULAR_18' && exit 1)"
  },
  "dependencies": {
    "@accretion_ui/angular_18": "^0.1.2",
    "@accretion_ui/core": "^0.1.5",
    "@angular/animations": "18.2.14",
    "@angular/common": "18.2.14",
    "@angular/compiler": "18.2.14",
    "@angular/core": "18.2.14",
    "@angular/platform-browser": "18.2.14",
    "@angular/platform-browser-dynamic": "18.2.14",
    "rxjs": "~7.8.1",
    "tslib": "^2.8.1",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "18.2.21",
    "@angular/cli": "18.2.21",
    "@storybook/angular": "^10.2.14",
    "chromatic": "^15.2.0",
    "storybook": "^10.2.14",
    "typescript": "~5.5.4"
  }
}
