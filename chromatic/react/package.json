{
  "name": "accretion-ui-react-chromatic",
  "private": true,
  "version": "0.1.0",
  "description": "Storybook and Chromatic for @accretion_ui/react",
  "scripts": {
    "storybook": "storybook dev -p 6008",
    "build-storybook": "storybook build",
    "chromatic": "test -n \"$CHROMATIC_PROJECT_TOKEN_REACT\" && chromatic --project-token=\"$CHROMATIC_PROJECT_TOKEN_REACT\" --build-script-name=build-storybook --exit-zero-on-changes || (echo 'Missing CHROMATIC_PROJECT_TOKEN_REACT' && exit 1)"
  },
  "dependencies": {
    "@accretion_ui/core": "file:../../components/core",
    "@accretion_ui/react": "file:../../components/react",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.2.14",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "chromatic": "^15.2.0",
    "storybook": "^10.2.14",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
