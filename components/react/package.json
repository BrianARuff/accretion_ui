{
  "name": "@accretion_ui/react",
  "version": "0.2.3",
  "description": "React wrappers for Accretion UI web components.",
  "keywords": [
    "accretion",
    "design-system",
    "react",
    "web-components",
    "stencil"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BrianARuff/accretion_react.git"
  },
  "bugs": {
    "url": "https://github.com/BrianARuff/accretion_react/issues"
  },
  "homepage": "https://github.com/BrianARuff/accretion_react#readme",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "generate": "npm --prefix ../core run build",
    "patch-generated-components": "node ./scripts/patch-generated-components.mjs",
    "build": "npm run clean && npm run generate && npm run patch-generated-components && tsc -p tsconfig.build.json",
    "watch": "tsc -p tsconfig.build.json --watch",
    "prepublishOnly": "npm run build",
    "publish:package": "npm publish --access public"
  },
  "dependencies": {
    "@accretion_ui/core": "^0.2.3",
    "@stencil/react-output-target": "^1.4.2"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
