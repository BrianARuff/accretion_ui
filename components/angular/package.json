{
  "name": "@accretion/angular",
  "version": "0.1.0",
  "description": "Angular wrappers for Accretion UI web components.",
  "license": "MIT",
  "sideEffects": false,
  "scripts": {
    "clean": "rm -rf dist",
    "generate": "npm --prefix ../core run build",
    "build": "npm run clean && npm run generate && ng-packagr -p ng-package.json",
    "watch": "ng-packagr -p ng-package.json -w",
    "prepublishOnly": "npm run build",
    "publish:package": "npm run build && npm publish ./dist --access public"
  },
  "peerDependencies": {
    "@accretion/core": "^0.1.0",
    "@angular/common": "^16.2.0 || ^17.0.0 || ^18.0.0",
    "@angular/core": "^16.2.0 || ^17.0.0 || ^18.0.0",
    "rxjs": "^7.8.0"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@accretion/core": "file:../core",
    "@angular/compiler": "16.2.12",
    "@angular/compiler-cli": "16.2.12",
    "ng-packagr": "16.2.3",
    "typescript": "~5.1.6"
  },
  "publishConfig": {
    "access": "public"
  }
}
