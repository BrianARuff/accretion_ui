{
  "name": "@accretion_ui/angular_21",
  "version": "0.1.2",
  "description": "Angular 21 wrappers for Accretion UI web components.",
  "keywords": [
    "accretion",
    "design-system",
    "angular",
    "web-components",
    "stencil"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BrianARuff/accretion_angular_21.git"
  },
  "bugs": {
    "url": "https://github.com/BrianARuff/accretion_angular_21/issues"
  },
  "homepage": "https://github.com/BrianARuff/accretion_angular_21#readme",
  "license": "MIT",
  "sideEffects": false,
  "main": "fesm2022/accretion_ui-angular_21.mjs",
  "module": "fesm2022/accretion_ui-angular_21.mjs",
  "types": "types/accretion_ui-angular_21.d.ts",
  "scripts": {
    "clean": "rm -rf dist",
    "generate": "npm --prefix ../core run build",
    "build": "npm run clean && npm run generate && ng-packagr -p ng-package.json",
    "watch": "ng-packagr -p ng-package.json -w",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "publish:package": "npm run build && npm publish ./dist --access public"
  },
  "peerDependencies": {
    "@accretion_ui/core": "^0.1.5",
    "@angular/common": ">=21.0.0 <22.0.0",
    "@angular/core": ">=21.0.0 <22.0.0",
    "rxjs": "^7.8.0"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@accretion_ui/core": "file:../core",
    "@angular/common": "21.2.0",
    "@angular/compiler": "21.2.0",
    "@angular/compiler-cli": "21.2.0",
    "@angular/core": "21.2.0",
    "ng-packagr": "21.2.0",
    "typescript": "~5.9.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
